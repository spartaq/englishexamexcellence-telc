<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Serve existing files directly
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  
  # Serve static files directly
  RewriteCond %{REQUEST_URI} \.(css|js|svg|png|jpg|jpeg|gif|ico|webp|woff|woff2|ttf|otf|eot)$ [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule . - [L]
  
  # Directory index files (prerendered route shells) — serve them directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(.+/)?index\.html$ - [L]

  # Serve prerendered route shells for directory URLs (e.g. /hu/telc/b2/ → index.html)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}index.html -f
  RewriteRule ^(.+)/$ $1/index.html [L]

  # Root
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^$ /index.html [L]
  
  # Known SPA routes that DON'T have a prerendered shell — rewrite to root SPA
  # (currently all public routes have shells, so this section is effectively empty)
  # RewriteCond %{REQUEST_FILENAME} !-f
  # RewriteCond %{REQUEST_FILENAME} !-d
  # RewriteRule ^(pricing|sitemap|privacy|contact|telc-info)/?$ /index.html [L]
  
  # Anything else is a genuine 404 — no soft-404, no self-referencing canonical
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . - [R=404,L]
</IfModule>

# 404s still render the SPA (NotFoundPage is noindex), but with a real 404 status
ErrorDocument 404 /index.html

# SEO Optimization Headers
<IfModule mod_headers.c>
  # Enable CORS for fonts and assets
  <FilesMatch "\.(woff|woff2|ttf|otf|eot|svg)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  
  # Cache control for static assets
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|gif|ico|webp|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  
  # Cache control for HTML and API responses
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "max-age=86400, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  # X-Content-Type-Options
  Header always set X-Content-Type-Options "nosniff"
  
  # X-Frame-Options
  Header always set X-Frame-Options "SAMEORIGIN"
  
  # X-XSS-Protection
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>